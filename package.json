{
  "name": "hooper",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:db": "node scripts/check-db-migrations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"if(!process.env.CI){require('child_process').execSync('husky',{stdio:'inherit'})}\"",
    "reset:exercises": "node scripts/reset-exercises.mjs",
    "seed:exercises": "node scripts/seed-exercises.mjs"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
