# Supabase — shared project for the Hooper platform.
# Use the anon key only in client-facing code; RLS enforces access. All Stripe
# secret-key work happens in Supabase edge functions, never in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe publishable key (pk_test_… / pk_live_…) for the Payment Element.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# This app's public origin — used for password-reset and payment return URLs.
# Must also be in Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_BILLING_APP_URL=http://localhost:3001

# Where "Open the Hooper app" points (QR code + store badges). Placeholder
# until the app-store listings exist.
NEXT_PUBLIC_APP_LINK=https://hooper.co.nz/app
